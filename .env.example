# Copiar a .env en desarrollo local (no versionar .env).
# En producción (Passenger / Hostingplus): definir estas variables en el panel.

# Obligatorio en producción
SECRET_KEY=cambiar-por-clave-larga-y-unica
DEBUG=False
DB_NAME=delcochi_DelcoChile_Inventario
DB_USER=delcochi_usuario
DB_PASSWORD=cambiar-password-mysql
ALLOWED_HOSTS=inventario.delcochile.cl,www.inventario.delcochile.cl
CSRF_TRUSTED_ORIGINS=https://inventario.delcochile.cl,https://www.inventario.delcochile.cl

# Webhook MoreApp (obligatorio; sin este valor el endpoint responde 403)
MOREAPP_WEBHOOK_SECRET=cambiar-por-secreto-compartido-con-moreapp

# Recomendado en producción detrás de HTTPS (activar cuando X-Forwarded-Proto funcione)
# SECURE_SSL_REDIRECT=True
SECURE_SSL_REDIRECT=False

# Opcional
SESSION_COOKIE_AGE=28800
ABSOLUTE_SESSION_TIMEOUT_SECONDS=28800
MOREAPP_WEBHOOK_REALTIME_ENABLED=true
MOREAPP_AUTO_SYNC_ENABLED=false
MOREAPP_REGISTROS_DIR=

# FTPS MoreApp (solo si se usa sync por carpetas)
# FTPS_HOST=
# FTPS_PORT=21
# FTPS_USERNAME=
# FTPS_PASSWORD=
# FTPS_BASE_PATH=/
# FTPS_PASSIVE_MODE=True
