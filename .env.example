# ============================================================
# ARCHIVO SOLO PARA EL SERVIDOR (Hostingplus)
# ============================================================
# 1) En cPanel → Administrador de archivos → carpeta del proyecto
#    (donde está passenger_wsgi.py)
# 2) Crear archivo llamado exactamente: .env
# 3) Pegar este contenido, completar los valores reales, Guardar
# 4) Setup Python App → Restart
# 5) NO subir este archivo a Git
# ============================================================

DEBUG=False

# Generar una clave nueva (no reutilizar plantillas). Ejemplo de cómo crear una:
# En Terminal del hosting:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# MySQL (cPanel → Bases de datos MySQL: nombre, usuario y contraseña)
DB_NAME=nombre_base_de_datos
DB_USER=usuario_base_de_datos
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Mismo secreto que configures en MoreApp (header X-MoreApp-Secret)
MOREAPP_WEBHOOK_SECRET=

# API REST MoreApp v1.0 (X-Api-Key)
# Mantener en secreto; NO subir el valor real a Git.
MOREAPP_API_ENABLED=false
MOREAPP_API_BASE_URL=https://api.moreapp.com/api/v1.0
MOREAPP_API_KEY=
MOREAPP_CUSTOMER_ID=
MOREAPP_API_TIMEOUT_SECONDS=20

ALLOWED_HOSTS=inventario.delcochile.cl,www.inventario.delcochile.cl
CSRF_TRUSTED_ORIGINS=https://inventario.delcochile.cl,https://www.inventario.delcochile.cl

SECURE_SSL_REDIRECT=False
