# Configuración de Passenger para aplicación Django
PassengerEnabled On
PassengerAppRoot /home50/delcochi/APPS_WEB/Aplicacion_Bonita

# Archivo de inicio de la aplicación
PassengerStartupFile passenger_wsgi.py

# Ruta al intérprete de Python del entorno virtual
PassengerPython /home50/delcochi/virtualenv/APPS_WEB/Aplicacion_Bonita/3.8/bin/python

# Punto de entrada de la aplicación WSGI
PassengerAppType wsgi

# Configuración de rendimiento
PassengerMinInstances 1
PassengerMaxPoolSize 6

# Archivos estáticos - no pasar por Django
<FilesMatch "\.(jpg|jpeg|png|gif|css|js|ico|svg|woff|woff2|ttf|eot|map|txt|xml|webp|mp4|pdf)$">
    PassengerEnabled off
</FilesMatch>

# Proteger archivos sensibles
<FilesMatch "^(\.env|\.git|passenger_wsgi\.py|manage\.py|settings.*\.py)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Habilitar compresión
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cacheo de archivos estáticos
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# Seguridad adicional
ServerSignature Off
Options -Indexes
