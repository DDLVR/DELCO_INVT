# =============================================================================
# public_html/.htaccess  —  delcochile.cl + inventario.delcochile.cl
# =============================================================================
# DÓNDE: carpeta public_html (raíz del hosting / sitio corporativo)
# NO uses aquí el .htaccess de la app Django.
#
# - https://delcochile.cl/            → Site.pro (carpeta sitepro/)
# - https://inventario.delcochile.cl/ → Django/Passenger (sin rewrite sitepro)
# =============================================================================

<IfModule pagespeed_module>
	ModPagespeed off
</IfModule>

Options -Indexes

# --- Seguridad: secretos / logs / backups ---
<FilesMatch "(?i)^(\.env|\.env\..*|\.git|\.gitignore|\.htpasswd|passenger_wsgi\.py|manage\.py|requirements\.txt|db\.sqlite3|.*\.sqlite3|web\.config|php_errors\.log|error_log|.*\.log|.*\.bak|.*\.sql|.*\.pem|.*\.key)$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>

RedirectMatch 404 (?i)/(?:\.git|venv|venv38|\.venv|__pycache__)(/|$)

<IfModule mod_headers.c>
	Header always set X-Content-Type-Options "nosniff"
	Header always set X-Frame-Options "SAMEORIGIN"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
	Header unset X-Powered-By
</IfModule>

<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresDefault A0
	ExpiresByType image/gif A691200
	ExpiresByType image/png A691200
	ExpiresByType image/jpeg A691200
	ExpiresByType image/webp A691200
	ExpiresByType text/css A691200
	ExpiresByType text/javascript A691200
	ExpiresByType application/javascript A691200
	ExpiresByType font/otf A691200
	ExpiresByType font/ttf A691200
	ExpiresByType font/woff A691200
	ExpiresByType font/woff2 A691200
</IfModule>

ErrorDocument 401 "Unauthorized"
ErrorDocument 403 "Forbidden"

RewriteEngine On
RewriteBase /

RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]
RewriteCond %{HTTP:X-Server-Addr} ^(.*)
RewriteRule .* - [e=HTTP_X_SERVER_ADDR:%1]

# SSL / validaciones
RewriteRule ^\.well-known/.+ - [L]

# HTTPS
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

DirectoryIndex index.php index.cgi index.html

# -----------------------------------------------------------------------------
# INVENTARIO → no pasar por sitepro (Passenger/Django)
# -----------------------------------------------------------------------------
RewriteCond %{HTTP_HOST} ^(www\.)?inventario\.delcochile\.cl$ [NC]
RewriteRule ^ - [L]

# -----------------------------------------------------------------------------
# delcochile.cl → Site.pro
# -----------------------------------------------------------------------------
RewriteCond %{HTTP_HOST} ^(www\.)?delcochile\.cl$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f [OR]
RewriteCond %{REQUEST_URI} ^\/(js\/(main\.js|bootstrap\.min\.js)|css\/([0-9a-f]+\.css|common\.css|site\.css|bootstrap\.min\.css)|sitemap\.xml)$
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ sitepro/$1 [L,QSA]

# Anti-hotlink (permite referer vacío)
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?delcochile\.cl(/.*)?$ [NC]
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?inventario\.delcochile\.cl(/.*)?$ [NC]
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?delcocar\.cl(/.*)?$ [NC]
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?delcocar\.cl\.delcochile\.cl(/.*)?$ [NC]
RewriteRule \.(?:jpe?g|gif|png|bmp|webp)$ - [F,NC]

# php -- BEGIN cPanel-generated handler, do not edit
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
